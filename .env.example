# Local-only configuration. Copy this file to .env and replace the secret.
AUTH_MODE=local
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters
CREDENTIAL_ENCRYPTION_KEY=
ACCESS_TOKEN_MINUTES=43200
DEFAULT_TOKEN_LIMIT=1000000000
DEFAULT_OLLAMA_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://127.0.0.1:11434
DATABASE_PATH=agents.db
UPLOADS_DIR=uploads

# Optional: set a Hugging Face token only if you need gated models/providers.
HF_TOKEN=

# Optional local tool overrides. The app can also install tools from its UI.
FFMPEG_BINARY=
FFPROBE_BINARY=
